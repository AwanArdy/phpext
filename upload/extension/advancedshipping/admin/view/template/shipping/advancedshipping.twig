<script type="text/javascript"><!--
	$('.toggle button').click(function(){
		var parent = $(this).closest('.toggle');
		if ($(this).hasClass('unlocked_active')) {
			$('input[name=\''+ $(this).attr('data-setting') +'\']').val(0);
		} else {
			$('input[name=\''+ $(this).attr('data-setting') +'\']').val(1);
		}
		$('button', parent).toggleClass('unlocked_active unlocked_inactive btn-default btn-oca');
		autosave();
	});

	$('.save').change(function() { autosave($(this).attr('name')); });
	$('.save').keyup(function(e) { if (e.keyCode == 13) { autosave($(this).attr('name')); } });

	function editRate() {
		$('#rates-body tr td:not(:first-child)').off('click').on('click', function () {
			var editUrl = $(this).parent().attr('data-rate-edit');
			if (editUrl) {
				window.location.replace(editUrl);
			}
		});
	}

	function switchAsTab(btn) {
		if (!btn) { return; }
		var targetSelector = btn.getAttribute('data-bs-target');
		if (!targetSelector) { return; }

		document.querySelectorAll('.as-nav-pills .nav-link').forEach(function(b) {
			b.classList.remove('active');
			b.setAttribute('aria-selected', 'false');
		});
		btn.classList.add('active');
		btn.setAttribute('aria-selected', 'true');

		document.querySelectorAll('#as-content .tab-content > .tab-pane').forEach(function(pane) {
			pane.classList.remove('active', 'show');
		});

		var pane = document.querySelector(targetSelector);
		if (pane) {
			pane.classList.add('active');
		}
	}

	$(document).on('click', '.as-nav-pills .nav-link', function(e) {
		e.preventDefault();
		e.stopPropagation();
		switchAsTab(this);
	});

	$(document).ready(function() {
		editRate();
		tooltips();
		// Ensure only the active tab pane is visible after load/refresh
		var activeBtn = document.querySelector('.as-nav-pills .nav-link.active');
		if (activeBtn) {
			switchAsTab(activeBtn);
		} else {
			var firstBtn = document.querySelector('.as-nav-pills .nav-link');
			if (firstBtn) { switchAsTab(firstBtn); }
		}
	});
//--></script>

<script type="text/javascript"><!--
  var tooltip_status = true;
  function tooltips() {
    var selector = '[data-bs-toggle="tooltip"], [rel="tooltip"]';
    var tooltipEls = [].slice.call(document.querySelectorAll(selector));
    tooltipEls.forEach(function(el) {
      // Skip pure modal triggers that only open modals (no title)
      if (!el.getAttribute('title') && !el.getAttribute('data-bs-original-title') && !el.getAttribute('data-bs-title')) {
        return;
      }
      var existing = bootstrap.Tooltip.getInstance(el);
      if (tooltip_status) {
        if (existing) {
          existing.enable();
        } else {
          var opts = { trigger: 'hover', container: 'body', boundary: 'window' };
          var placement = el.getAttribute('data-bs-placement') || el.getAttribute('data-placement');
          if (placement) { opts.placement = placement; }
          new bootstrap.Tooltip(el, opts);
        }
      } else if (existing) {
        existing.disable();
      }
    });
  }
//--></script>

<script type="text/javascript"><!--
  $('.filter').change(function() { filter(); });
  $('.filter').keyup(function(e) { if (e.keyCode == 13) { filter(); } });

  $('#clearFilter').bind('click', function() {
    $('.filter').val('');
    filter();
  });

  function filter() {
    $.ajax({
      url: 'index.php?route=extension/advancedshipping/shipping/advancedshipping.filter&user_token={{ user_token }}',
      data: $('.filter').serialize(),
      type: 'post',
      dataType: 'json',
      success: function(json) {
        var html = '';
        if (json['success'] && json['rates']) {
          $.each(json['rates'], function(index, value) {
            html += '<tr data-rate-edit="'+ value['edit'] +'" id="rate'+ value['rate_id'] +'">';
            html += '  <td class="text-left"><div class="as-checkbox"><input type="checkbox" name="selected[]" value="'+ value['rate_id'] +'" id="select-rate-'+ value['rate_id'] +'"><label for="select-rate-'+ value['rate_id'] +'">&nbsp;</label></div></td>';
            html += '  <td class="text-left"><a role="button" href="'+ value['edit'] +'" class="btn btn-link">'+ value['description'] +'</a></td>';
            html += '  <td class="text-left"><a role="button" href="'+ value['edit'] +'" class="btn btn-link">'+ value['name'] +'</a></td>';
            html += '  <td class="text-left">'+ value['status'] +'</td>';
            html += '  <td class="text-left">'+ value['group'] +'</td>';
            html += '  <td class="text-right">&nbsp;</td>';
            html += '</tr>';
          });
        } else {
          html += '<tr><td colspan="6" class="text-center">{{ text.text_no_results }}</td></tr>';
        }

        $('#rates-body').html(html);
        tooltips();
        editRate();
      }
    });
  }
//--></script>

